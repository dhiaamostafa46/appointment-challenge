@echo off
chcp 65001 > nul
title لوحة فحص تحدي حجز المواعيد - إلهام
cls
echo ================================================================
echo      لوحة فحص تحدي حجز المواعيد - Elham Future IT
echo ================================================================
echo.
echo [1/3] التحقق من بناء المشروع (TypeScript Build)...
call npm run build
if %errorlevel% neq 0 (
    echo خطأ في بناء المشروع!
    pause
    exit /b %errorlevel%
)
echo      تم البناء بنجاح!
echo.
echo [2/3] تشغيل اختبارات التحقق من المدخلات (Unit Tests)...
call npm run test:unit
echo.
echo [3/3] فتح لوحة التحكم التفاعلية في المتصفح...
start http://localhost:4000/
echo.
echo ================================================================
echo  تم فتح لوحة التحكم في المتصفح على الرابط:
echo  http://localhost:4000/
echo  اضغط على الزر: [⚡ تشغيل دورة الفحص الشاملة بنقرة واحدة]
echo ================================================================
echo.
pause
