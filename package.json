{
  "name": "appointment-challenge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "prisma db seed",
    "test": "jest tests/validation.test.ts tests/booking.test.ts --runInBand",
    "test:unit": "jest tests/validation.test.ts --runInBand",
    "test:integration": "prisma migrate deploy && prisma db seed && jest tests/booking.test.ts --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^4.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "swagger-ui-express": "^4.6.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.0.0",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "axios": "^1.4.0",
    "jest": "^29.0.0",
    "pg-mem": "^3.0.14",
    "prisma": "^4.15.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4",
    "wait-on": "^7.0.1"
  }
}
